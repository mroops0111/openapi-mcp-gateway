{
  "openapi": "3.0.0",
  "info": {
    "title": "Petstore Resource Demo",
    "version": "1.0.0",
    "description": "Variant of the public Swagger Petstore spec with two operations opted into MCP resource exposure via `x-mcp-integration.expose.resource`."
  },
  "servers": [
    {"url": "https://petstore3.swagger.io/api/v3"}
  ],
  "paths": {
    "/pet/findByStatus": {
      "get": {
        "operationId": "findPetsByStatus",
        "summary": "List pets by status",
        "description": "No resource opt-in: stays a regular tool so the LLM can search with arguments.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "enum": ["available", "pending", "sold"]}
          }
        ],
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/pet/{petId}": {
      "get": {
        "operationId": "getPetById",
        "summary": "Fetch one pet by id",
        "description": "Addressable single-record read; opted into a resource template so MCP clients can attach a specific pet by URI.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {"type": "integer"}
          }
        ],
        "x-mcp-integration": {
          "expose": {
            "resource": {
              "name": "pet",
              "mime_type": "application/json"
            }
          }
        },
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/store/inventory": {
      "get": {
        "operationId": "getInventory",
        "summary": "Aggregate inventory snapshot",
        "description": "No path parameters; opted into a resource so the LLM can grab the snapshot on demand without using a tool slot.",
        "x-mcp-integration": {
          "expose": {
            "resource": {
              "name": "inventory",
              "mime_type": "application/json"
            }
          }
        },
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
