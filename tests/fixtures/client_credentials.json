{
  "openapi": "3.0.0",
  "info": {
    "title": "Client-credentials petstore",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://petstore.example.com/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/token",
            "scopes": {
              "api": "API access"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": ["api"]
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
